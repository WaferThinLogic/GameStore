@model GameStore.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1><i class="bi bi-receipt"></i> Order #@Model.Id Details</h1>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Orders
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Order Items</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Game</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderDetails != null)
                                {
                                    @foreach (var item in Model.OrderDetails)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@item.Game?.Title</strong>
                                                @if (item.Game?.Category != null)
                                                {
                                                    <br /><small class="text-muted">@item.Game.Category.Name</small>
                                                }
                                            </td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">$@item.UnitPrice.ToString("F2")</td>
                                            <td class="text-end fw-bold">$@item.TotalPrice.ToString("F2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end">Subtotal:</td>
                                    <td class="text-end">$@Model.SubTotal.ToString("F2")</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end">Tax (8%):</td>
                                    <td class="text-end">$@Model.Tax.ToString("F2")</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end">Shipping:</td>
                                    <td class="text-end">$@Model.ShippingCost.ToString("F2")</td>
                                </tr>
                                <tr class="table-primary">
                                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                    <td class="text-end"><strong class="text-primary">$@Model.TotalAmount.ToString("F2")</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Customer Information</h5>
                </div>
                <div class="card-body">
                    <p><strong>@Model.FirstName @Model.LastName</strong></p>
                    <address>
                        @Model.Address<br />
                        @Model.City, @Model.State @Model.PostalCode<br />
                        @Model.Country
                    </address>
                    <p>
                        <i class="bi bi-envelope"></i> @Model.Email<br />
                        <i class="bi bi-telephone"></i> @Model.Phone
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Order Status</h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post" class="mb-3">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">Order Status</label>
                            <select name="status" class="form-select">
                                <option value="Processing" selected="@(Model.OrderStatus == "Processing")">Processing</option>
                                <option value="Shipped" selected="@(Model.OrderStatus == "Shipped")">Shipped</option>
                                <option value="Completed" selected="@(Model.OrderStatus == "Completed")">Completed</option>
                                <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled")">Cancelled</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Update Status</button>
                    </form>

                    <form asp-action="UpdatePaymentStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">Payment Status</label>
                            <select name="paymentStatus" class="form-select">
                                <option value="Pending" selected="@(Model.PaymentStatus == "Pending")">Pending</option>
                                <option value="Completed" selected="@(Model.PaymentStatus == "Completed")">Completed</option>
                                <option value="Refunded" selected="@(Model.PaymentStatus == "Refunded")">Refunded</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Update Payment</button>
                    </form>

                    <hr />
                    <div>
                        <span class="text-muted">Current Status:</span><br />
                        <span class="badge bg-@(Model.OrderStatus == "Completed" ? "success" : Model.OrderStatus == "Processing" ? "info" : "warning")">
                            @Model.OrderStatus
                        </span>
                        <span class="badge bg-@(Model.PaymentStatus == "Completed" ? "success" : Model.PaymentStatus == "Refunded" ? "danger" : "warning")">
                            @Model.PaymentStatus
                        </span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Order Info</h5>
                </div>
                <div class="card-body">
                    <p><strong>Order Date:</strong> @Model.OrderDate.ToString("MMMM dd, yyyy HH:mm")</p>
                    <p><strong>Payment Method:</strong> @Model.PaymentMethod</p>
                </div>
            </div>
        </div>
    </div>
</div>