@model GameStore.Areas.Admin.Controllers.ReportsDashboardViewModel

@{
    ViewData["Title"] = "Reports Dashboard";
}

<div class="container-fluid">
    <h1 class="mb-4"><i class="bi bi-graph-up"></i> Reports Dashboard</h1>

    <!-- Key Metrics Row -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Products</h6>
                            <h3 class="mb-0">@Model.TotalProducts</h3>
                        </div>
                        <i class="bi bi-box-seam text-primary" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Sales</h6>
                            <h3 class="mb-0">@Model.TotalSales.ToString("C")</h3>
                        </div>
                        <i class="bi bi-cash-coin text-success" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Orders</h6>
                            <h3 class="mb-0">@Model.TotalOrders</h3>
                        </div>
                        <i class="bi bi-receipt text-info" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Profit Margin</h6>
                            <h3 class="mb-0">@Model.ProfitMargin.ToString("F1")%</h3>
                        </div>
                        <i class="bi bi-percent text-warning" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock Alerts Row -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Out of Stock Items</h5>
                    <a asp-action="StockMonitoring" class="btn btn-sm btn-light">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.OutOfStockItems.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Category</th>
                                        <th>Supplier</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OutOfStockItems.Take(5))
                                    {
                                        <tr>
                                            <td>@item.Title</td>
                                            <td>@item.Category?.Name</td>
                                            <td>@item.Supplier?.Name</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-check-circle" style="font-size: 2rem;"></i>
                            <p class="mb-0 mt-2">No out of stock items</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-exclamation-circle"></i> Low Stock Items</h5>
                    <a asp-action="StockMonitoring" class="btn btn-sm btn-light">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.LowStockItems.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Stock</th>
                                        <th>Threshold</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.LowStockItems.Take(5))
                                    {
                                        <tr>
                                            <td>@item.Title</td>
                                            <td><span class="badge bg-warning">@item.Stock</span></td>
                                            <td>@item.MinStockThreshold</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-check-circle" style="font-size: 2rem;"></i>
                            <p class="mb-0 mt-2">All stock levels are healthy</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Purchase Orders Summary -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-receipt"></i> Purchase Orders Summary</h5>
                    <a asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Index" class="btn btn-sm btn-primary">Manage POs</a>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="text-center">
                                <h4 class="text-primary">@Model.PendingPOs</h4>
                                <p class="text-muted">Pending Orders</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center">
                                <h4 class="text-success">@Model.TotalPOValue.ToString("C")</h4>
                                <p class="text-muted">Total PO Value</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center">
                                <h4 class="text-info">@Model.TotalStockValue.ToString("C")</h4>
                                <p class="text-muted">Stock Value</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <a asp-action="StockMonitoring" class="btn btn-outline-primary w-100 mb-2">
                                <i class="bi bi-box-seam"></i> Stock Monitoring
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-action="SupplierPerformance" class="btn btn-outline-success w-100 mb-2">
                                <i class="bi bi-truck"></i> Supplier Performance
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-action="Profitability" class="btn btn-outline-warning w-100 mb-2">
                                <i class="bi bi-graph-up"></i> Profitability Analysis
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-action="PriceHistory" class="btn btn-outline-info w-100 mb-2">
                                <i class="bi bi-clock-history"></i> Price History
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>