@model GameStore.Models.PurchaseOrder

@{
    ViewData["Title"] = "Purchase Order Details";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-receipt"></i> Purchase Order Details</h1>
        <div class="btn-group">
            @if (Model.Status == "Draft")
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <form asp-action="Submit" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-send"></i> Submit Order
                    </button>
                </form>
            }
            @if (Model.Status == "Submitted")
            {
                <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Confirm
                    </button>
                </form>
                <form asp-action="Receive" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-box-seam"></i> Receive
                    </button>
                </form>
            }
            @if (Model.Status == "Confirmed")
            {
                <form asp-action="Receive" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-box-seam"></i> Receive
                    </button>
                </form>
            }
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Order Information</h5>
                    @switch (Model.Status)
                    {
                        case "Draft":
                            <span class="badge bg-secondary">Draft</span>
                            break;
                        case "Submitted":
                            <span class="badge bg-info">Submitted</span>
                            break;
                        case "Confirmed":
                            <span class="badge bg-primary">Confirmed</span>
                            break;
                        case "Received":
                            <span class="badge bg-success">Received</span>
                            break;
                        case "Cancelled":
                            <span class="badge bg-danger">Cancelled</span>
                            break;
                    }
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Order Number:</strong>
                            <p>@Model.OrderNumber</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Order Date:</strong>
                            <p>@Model.OrderDate.ToString("MMM dd, yyyy HH:mm")</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Supplier:</strong>
                            <p>@Model.Supplier?.Name</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Expected Delivery:</strong>
                            <p>@(Model.ExpectedDeliveryDate?.ToString("MMM dd, yyyy") ?? "Not specified")</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mb-3">
                            <strong>Notes:</strong>
                            <p>@Model.Notes</p>
                        </div>
                    }
                    <hr />
                    <div class="row">
                        <div class="col-md-4">
                            <strong>Submitted:</strong>
                            <p>@(Model.SubmittedDate?.ToString("MMM dd, yyyy HH:mm") ?? "-")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Confirmed:</strong>
                            <p>@(Model.ConfirmedDate?.ToString("MMM dd, yyyy HH:mm") ?? "-")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Received:</strong>
                            <p>@(Model.ReceivedDate?.ToString("MMM dd, yyyy HH:mm") ?? "-")</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Order Items</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Game</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-end">Unit Cost</th>
                                    <th class="text-end">Total Cost</th>
                                    <th class="text-center">Received</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PurchaseOrderItems != null && Model.PurchaseOrderItems.Any())
                                {
                                    @foreach (var item in Model.PurchaseOrderItems)
                                    {
                                        <tr>
                                            <td>@item.Game?.Title</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@item.UnitCost.ToString("C")</td>
                                            <td class="text-end">@item.TotalCost.ToString("C")</td>
                                            <td class="text-center">
                                                @if (item.QuantityReceived.HasValue)
                                                {
                                                    <span class="badge bg-success">@item.QuantityReceived</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Pending</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No items in this order</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span>@Model.TotalAmount.ToString("C")</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <strong>Total Amount:</strong>
                        <strong>@Model.TotalAmount.ToString("C")</strong>
                    </div>
                </div>
            </div>

            @if (Model.Supplier != null)
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Supplier Information</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-2"><strong>@Model.Supplier.Name</strong></p>
                        @if (!string.IsNullOrEmpty(Model.Supplier.ContactName))
                        {
                            <p class="mb-1"><i class="bi bi-person"></i> @Model.Supplier.ContactName</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.Supplier.Email))
                        {
                            <p class="mb-1"><i class="bi bi-envelope"></i> @Model.Supplier.Email</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.Supplier.Phone))
                        {
                            <p class="mb-1"><i class="bi bi-telephone"></i> @Model.Supplier.Phone</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.Supplier.Address))
                        {
                            <p class="mb-0"><i class="bi bi-geo-alt"></i> @Model.Supplier.Address</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>