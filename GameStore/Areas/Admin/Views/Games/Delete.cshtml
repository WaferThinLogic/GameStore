@model GameStore.Models.Game

@{
    ViewData["Title"] = "Delete Game";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-trash"></i> Delete Game</h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="alert alert-danger">
            <h5>Are you sure you want to delete this game?</h5>
        </div>
        
        <div class="row">
            <div class="col-md-4">
                <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded" />
            </div>
            <div class="col-md-8">
                <h3>@Model.Title</h3>
                <p class="text-muted">@Model.Category?.Name</p>
                <h4 class="text-success">$@Model.Price.ToString("F2")</h4>
                <hr />
                <h5>Description</h5>
                <p>@Model.Description</p>
            </div>
        </div>
        
        <form asp-action="Delete" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Yes, Delete
            </button>
        </form>
    </div>
</div>