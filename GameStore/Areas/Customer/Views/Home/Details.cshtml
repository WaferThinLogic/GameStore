@model GameStore.Models.Game

@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="@Model.Title">
        }
        else
        {
            <div class="bg-secondary d-flex align-items-center justify-content-center rounded" style="height: 400px;">
                <i class="bi bi-controller display-1 text-white"></i>
            </div>
        }
    </div>
    <div class="col-md-6">
        <h1 class="mb-3">@Model.Title</h1>
        <p class="text-muted">Category: <a asp-action="Browse" asp-route-categoryId="@Model.CategoryId">@Model.Category?.Name</a></p>
        <h2 class="text-primary mb-2">$@Model.Price</h2>
        <div class="mb-4">
            @if (Model.Stock > 0)
            {
                <span class="badge bg-success">In Stock (@Model.Stock available)</span>
            }
            else
            {
                <span class="badge bg-danger">Out of Stock</span>
            }
        </div>
        <p class="lead">@Model.Description</p>
        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-4">
            <input type="hidden" name="gameId" value="@Model.Id" />
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-cart-plus"></i> Add to Cart
            </button>
        </form>
        <a asp-action="Browse" class="btn btn-outline-secondary btn-lg mt-2">
            <i class="bi bi-arrow-left"></i> Back to Browse
        </a>
    </div>
</div>