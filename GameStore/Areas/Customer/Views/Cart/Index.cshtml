@model GameStore.Models.Cart

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="bi bi-cart"></i> Your Shopping Cart</h1>

    @if (Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Your cart is empty. <a asp-area="Customer" asp-controller="Home" asp-action="Browse">Browse games</a> to add something!
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Game</th>
                                        <th>Price</th>
                                        <th>Quantity</th>
                                        <th>Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.CartItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.Game?.ImageUrl))
                                                    {
                                                        <img src="@item.Game.ImageUrl" alt="@item.Game.Title" class="me-3 rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="me-3 rounded bg-secondary d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                            <i class="bi bi-controller text-white"></i>
                                                        </div>
                                                    }
                                                    <div>
                                                        <h6 class="mb-0">@item.Game?.Title</h6>
                                                        <small class="text-muted">@item.Game?.Category?.Name</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="align-middle">$@item.Price</td>
                                            <td class="align-middle" style="width: 150px;">
                                                <form asp-action="UpdateQuantity" method="post" class="d-flex">
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <div class="input-group input-group-sm">
                                                        <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-outline-secondary">-</button>
                                                        <input type="text" class="form-control text-center" value="@item.Quantity" readonly />
                                                        <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-outline-secondary">+</button>
                                                    </div>
                                                </form>
                                            </td>
                                            <td class="align-middle fw-bold">$@(item.Price * item.Quantity)</td>
                                            <td class="align-middle text-end">
                                                <form asp-action="RemoveFromCart" method="post" class="d-inline">
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <button type="submit" class="btn btn-link text-danger p-0" title="Remove from cart">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        @{
                            var subtotal = Model.CartItems.Sum(ci => ci.Price * ci.Quantity);
                        }
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span>$@subtotal</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax</span>
                            <span>$0.00</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5">Total</span>
                            <span class="h5 fw-bold text-primary">$@subtotal</span>
                        </div>
                        <a asp-action="Checkout" class="btn btn-primary w-100 btn-lg mb-2">
                            <i class="bi bi-credit-card"></i> Checkout
                        </a>
                        <a asp-area="Customer" asp-controller="Home" asp-action="Browse" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-arrow-left"></i> Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>