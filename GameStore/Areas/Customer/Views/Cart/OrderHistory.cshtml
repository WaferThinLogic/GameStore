@model List<GameStore.Models.Order>

@{
    ViewData["Title"] = "Order History";
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="bi bi-clock-history"></i> Order History</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> You haven't placed any orders yet. 
            <a asp-area="Customer" asp-controller="Home" asp-action="Browse">Browse games</a> to make your first purchase!
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Order #@order.Id</span>
                            <span class="badge bg-@(order.OrderStatus == "Completed" ? "success" : order.OrderStatus == "Processing" ? "info" : "warning")">
                                @order.OrderStatus
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted">Order Date</small>
                                    <p class="mb-0">@order.OrderDate.ToString("MMM dd, yyyy")</p>
                                </div>
                                <div class="col-6 text-end">
                                    <small class="text-muted">Total Amount</small>
                                    <p class="mb-0 fw-bold text-primary">$@order.TotalAmount.ToString("F2")</p>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <small class="text-muted">Items</small>
                                <ul class="list-unstyled mb-0">
                                    @if (order.OrderDetails != null)
                                    {
                                        @foreach (var item in order.OrderDetails.Take(3))
                                        {
                                            <li>@item.Game?.Title x @item.Quantity</li>
                                        }
                                        @if (order.OrderDetails.Count > 3)
                                        {
                                            <li class="text-muted">+ @(order.OrderDetails.Count - 3) more items...</li>
                                        }
                                    }
                                </ul>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Payment</small>
                                    <p class="mb-0">
                                        <span class="badge bg-@(order.PaymentStatus == "Completed" ? "success" : "warning")">
                                            @order.PaymentStatus
                                        </span>
                                    </p>
                                </div>
                                <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                                    View Details <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>